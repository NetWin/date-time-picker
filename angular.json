{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "schematics": {
    "@schematics/angular:component": {
      "type": "component",
      "style": "css"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "projects": {
    "docs": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "owl",
      "architect": {
        "build": {
          "builder": "@ng-doc/builder:vite-application",
          "options": {
            "configFile": "src/vite.config.mjs",
            "outputPath": "dist/docs"
          },
          "configurations": {
            "production": {
              "mode": "production"
            },
            "development": {
              "mode": "development"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@ng-doc/builder:vite-dev-server",
          "options": {
            "configFile": "src/vite.config.mjs",
            "port": 4201
          },
          "configurations": {
            "production": {
              "mode": "production"
            },
            "development": {
              "mode": "development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "docs:build"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"],
            "eslintConfig": "./eslint.config.js"
          }
        }
      }
    },
    "picker": {
      "projectType": "library",
      "root": "projects/picker",
      "sourceRoot": "projects/picker/src",
      "prefix": "owl",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/picker/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/picker/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/picker/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/picker/tsconfig.spec.json",
            "providersFile": "projects/picker/src/test-setup.ts"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/picker/src/lib/**/*.ts",
              "projects/picker/src/lib/**/*.html"
            ],
            "eslintConfig": "./eslint.config.js"
          }
        }
      }
    }
  }
}
