{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "bracketSameLine": true,
  "jsdoc": true,
  "singleAttributePerLine": true,
  "printWidth": 100,
  "proseWrap": "always",
  "quoteProps": "preserve",
  "singleQuote": true,
  "sortImports": { "newlinesBetween": false },
  "sortPackageJson": { "sortScripts": false },
  "trailingComma": "none"
}
